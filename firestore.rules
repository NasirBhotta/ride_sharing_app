rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Rides collection
    match /rides/{rideId} {
      // Participants and nearby riders (requested rides) can read
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.riderId ||
        resource.data.status == 'requested'
      );

      // Customers create ride requests
      allow create: if request.auth.uid == request.resource.data.customerId;

      // Participants can update; riders can accept open requests
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.riderId ||
        (
          resource.data.status == 'requested' &&
          request.resource.data.status == 'booked' &&
          request.resource.data.riderId == request.auth.uid
        )
      );

      // Messages subcollection - encrypted messages
      match /messages/{messageId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.customerId ||
                        request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.riderId;

        allow create: if request.auth.uid == request.resource.data.senderId &&
                        (request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.customerId ||
                         request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.riderId);

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
